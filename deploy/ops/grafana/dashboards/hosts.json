      "id": 3,
      "title": "Container Memory Usage",
      "type": "timeseries",
      "targets": [
        { "expr": "container_memory_working_set_bytes{name!=\"\"}", "legendFormat": "{{name}}" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 4,
      "title": "Host Health & Storage",
