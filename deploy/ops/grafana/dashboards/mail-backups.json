      "id": 3,
      "title": "Delivery Rate vs Submission Rate",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(mail_delivered_total[1m])", "legendFormat": "Delivered/s" },
        { "expr": "rate(mail_submissions_total[1m])", "legendFormat": "Submitted/s" }
