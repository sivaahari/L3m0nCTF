      "type": "timeseries",
      "targets": [
        { "expr": "rate(mail_rejected_total[1m])", "legendFormat": "Rejections/s" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
