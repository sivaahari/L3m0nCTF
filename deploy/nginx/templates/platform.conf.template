# The platform's server block. The ${...} names are filled in from the environment when nginx starts.

# Any request whose Host is not ours gets nothing at all (no body, connection closed).
server {
  listen 8080 default_server;
  server_name _;
  return 444;
}

server {
  listen 8080;
  server_name ${PLATFORM_HOST} ${EXTRA_HOST};

  include /etc/nginx/snippets/security-headers.conf;
  limit_req zone=general burst=60 nodelay;
  limit_conn perip 40;
  proxy_connect_timeout 5s;
  proxy_send_timeout 30s;
  proxy_read_timeout 60s;

  # The container's own health check. Reachable only from inside the container.
  location = /__nginx_health {
    allow 127.0.0.1;
    deny all;
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Health routes: never cached, no cookie (CTFd starts an anonymous session on every request, which has no place here).
  location = /healthcheck {
    limit_req zone=general burst=60 nodelay;
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/proxy.conf;
    proxy_hide_header Set-Cookie;
    add_header Cache-Control "no-store" always;
    access_log off;
  }
  location = /l3mon/healthz {
    limit_req zone=general burst=60 nodelay;
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/proxy.conf;
    proxy_hide_header Set-Cookie;
    add_header Cache-Control "no-store" always;
    access_log off;
  }

  # Sign-in, registration and password reset: slow down guessing from one address.
  location = /login {
    limit_req zone=general burst=60 nodelay;
    limit_req zone=login burst=5 nodelay;
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/proxy.conf;
  }
  location ~ ^/(register|reset_password|confirm)(/|$) {
    limit_req zone=general burst=60 nodelay;
    limit_req zone=login burst=5 nodelay;
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/proxy.conf;
  }

  # Flag submission: generous per address, because a whole campus can share one.
  location = /api/v1/challenges/attempt {
    limit_req zone=general burst=60 nodelay;
    limit_req zone=flags burst=60 nodelay;
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/proxy.conf;
  }

  # Live notifications (server-sent events): long-lived, unbuffered, few per visitor.
  location = /events {
    limit_conn perip 20;
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/proxy.conf;
    proxy_buffering off;
    proxy_cache off;
    chunked_transfer_encoding off;
    proxy_read_timeout 1h;
  }

  # The admin pages: only from the organisers' addresses (the list is a file that production replaces).
  location ^~ /admin {
    include /etc/nginx/snippets/admin-allow.conf;
    client_max_body_size 10m;
    limit_req zone=general burst=60 nodelay;
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/proxy.conf;
  }

  # Uploading challenge files (administrators only; CTFd checks the token or session). The only place besides /admin
  # where a body over 1m is accepted.
  location = /api/v1/files {
    client_max_body_size 10m;
    limit_req zone=general burst=60 nodelay;
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/proxy.conf;
  }

  location / {
    limit_req zone=general burst=60 nodelay;
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/proxy.conf;
  }
}
