# The settings the production stack reads from the shell, kept in a file OUTSIDE the repository (for example /etc/l3mon/production.env, mode 0640).
# Nothing secret belongs in it: the secrets are files in .secrets/. Use it with:
#
#   set -a; . /etc/l3mon/production.env; set +a
#   cd tools && python3 -m l3mon deploy check && cd ..        # must end with "0 blocked"
#   tools/compose.sh up -d --wait
#
L3MON_ENV=production
# the release tag you built (docker build -t l3mon/ctfd:<tag> ...): deploy a tag, never a moving branch
L3MON_IMAGE_TAG=v0.0.0
# the origin certificate, its key and Cloudflare's client-certificate authority (docs/deploy/platform-deployment.md, C1 and C3)
TLS_DIR=/etc/l3mon/tls
# the addresses the crew reaches /admin from: explicit addresses only (start from deploy/nginx/snippets/admin-nets.production.example.conf)
ADMIN_NETS_FILE=/etc/l3mon/admin-nets.conf
# the crew's host name behind Cloudflare Access (platform-deployment.md, C7); leave empty if there is none
EXTRA_HOST=crew.l3m0nctf.xyz
