    {"label": "the second solver of the dynamic programme", "do": [{"attempt": ["bob", "moth_cipher", "right"]}, {"attempt": ["alice", "lantern_walk", "right"]}],
     "ask": [{"board": "bob"}, {"panel": ["bob", "moth_cipher"]}]},
    {"label": "wrong flags, tries and a lock-out", "do": [{"attempt": ["cara", "careful_door", "wrong"]}, {"attempt": ["cara", "careful_door", "wrong"]}, {"attempt": ["cara", "careful_door", "wrong"]}, {"attempt": ["cara", "careful_door", "right"]}],
     "ask": [{"panel": ["cara", "careful_door"]}, {"panel": ["bob", "careful_door"]}]},
    {"label": "a hint costs TRP", "do": [{"hint": ["alice", "lantern_walk", 0]}],
     "ask": [{"board": "alice"}, {"panel": ["alice", "lantern_walk"]}]},
    {"label": "a bonus", "do": [{"bonus": ["studio-b", 40, "found a bug"]}],
     "ask": [{"board": "bob"}, {"board": "alice"}]},
    {"label": "the scheduled drop arrives", "do": [{"advance": 31}],
     "ask": [{"board": "alice"}, {"panel": ["alice", "steam_tunnel"]}]},
    {"label": "a hidden studio solves and does not count", "do": [{"hide": "studio-h"}, {"attempt": ["hal", "moth_cipher", "right"]}, {"attempt": ["hal", "coffee_break", "right"]}],
     "ask": [{"board": "alice"}, {"board": "hal"}, {"panel": ["hal", "coffee_break"]}]},
    {"label": "a banned studio stops counting", "do": [{"attempt": ["cara", "moth_cipher", "right"]}, {"ban": "studio-c"}],
     "ask": [{"board": "alice"}, {"panel": ["alice", "moth_cipher"]}]},
    {"label": "a solved programme is pulled back", "do": [{"release": ["programme", "lantern_walk", "off"]}],
     "ask": [{"board": "alice"}, {"board": "bob"}]},
    {"label": "and released again", "do": [{"release": ["programme", "lantern_walk", "on"]}],
     "ask": [{"board": "alice"}]},
    {"label": "the crew sets a broken programme's solves aside", "do": [{"void": ["moth_cipher", "the checker broke"]}],
     "ask": [{"board": "alice"}, {"board": "bob"}, {"panel": ["alice", "moth_cipher"]}]},
    {"label": "and puts them back", "do": [{"restore": "moth_cipher"}],
     "ask": [{"board": "alice"}, {"board": "bob"}, {"panel": ["alice", "moth_cipher"]}]},
    {"label": "paused", "do": [{"phase": "paused"}],
     "ask": [{"board": "alice"}, {"attempt": ["alice", "noodle_ledger", "right"]}, {"hint": ["alice", "lantern_walk", 1]}]},
    {"label": "the broadcast has ended", "do": [{"phase": "ended"}],
     "ask": [{"board": "alice"}, {"panel": ["alice", "hush_alley"]}, {"attempt": ["alice", "noodle_ledger", "right"]}, {"attempt": ["alice", "noodle_ledger", "wrong"]}, {"hint": ["alice", "lantern_walk", 1]}]}
  ]
