    {"label": "live, nothing on air yet (every programme and channel is withheld, as a freshly loaded plan)", "do": [{"phase": "live"}, {"release": ["programme", "lantern_walk", "off"]}, {"release": ["programme", "moth_cipher", "off"]}, {"release": ["programme", "hush_alley", "off"]}, {"release": ["programme", "noodle_ledger", "off"]}, {"release": ["programme", "steam_tunnel", "off"]}, {"release": ["programme", "careful_door", "off"]}, {"release": ["programme", "coffee_break", "off"]}],
